---
import { Image } from 'astro:assets';
import heroImg from '../assets/images/hero.jpg';
---

<section class="hero section--navy under-navbar">
  <div class="container hero__grid">
    <div class="hero__text">
      <p class="hero__eyebrow"><strong>GEGEN</strong> Energieverluste im Aufzugsschacht</p>
      <h1 class="hero__headline h1">Ich lese Strömungen. <br />Im Wasser wie in Ihren Gebäuden.</h1>
      <p class="hero__sub text-medium">
        Zweifacher Weltmeister im Kanu-Wildwasserrennsport, heute GEGEN-Experte für
        Energieverluste im Aufzugsschacht. Herstellerunabhängige Beratung für
        Bestandsimmobilien.
      </p>
      <a href="#kontakt" class="btn btn-fill-light">Gespräch anfragen</a>
    </div>
  </div>
  <Image
    src={heroImg}
    alt="Lars Walter-Sinsel, GEGEN-Experte von SHAFTCONSULT, im Vordergrund; im Hintergrund er als Kanu-Wildwassersportler im Wettkampf"
    class="hero__image"
    widths={[640, 1024, 1600, 2400]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="hero__overlay" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    /* Desktop: Seitenverhältnis exakt wie im Figma-Header (1440 × 799).
       Mobile bekommt unten ein eigenes, deutlich höheres Verhältnis (siehe
       Media Query), damit Text und Button nicht das ganze Bild verdecken. */
    aspect-ratio: 1440 / 799;
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
  }

  @media (max-width: 899px) {
    .hero {
      aspect-ratio: 3 / 4;
      min-height: 560px;
    }
  }

  .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    z-index: 0;
  }

  /* Figma: flaches 15% Schwarz-Overlay, kein Verlauf — die Verdunklung
     kommt bereits aus dem Foto selbst (Composite ist vorbereitet) */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.15);
    z-index: 0;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    width: 100%;
    /* .container setzt margin-inline:auto für Zentrierung — hier explizit
       aufheben, damit align-items:flex-start den Text wirklich linksbündig
       hält statt ihn als Flex-Item mit Auto-Margin zu zentrieren. */
    margin-inline: 0;
    padding-inline: var(--page-padding);
    /* Unterer Abstand (vorher padding-block am .hero) */
    padding-bottom: 65px;
  }

  .hero__text {
    max-width: 640px;
  }

  .hero__eyebrow {
    font-size: clamp(12px, 2.85vw, 16px);
    margin-bottom: 10px;
  }

  .hero__eyebrow strong {
    font-weight: 700;
  }

  .hero__headline {
    /* Prozentual mitskalierend statt fixem Breakpoint-Sprung */
    font-size: clamp(22.5px, 6.48vw, 56px);
    margin-bottom: 1.25rem;
  }

  .hero__sub {
    font-size: clamp(12px, 3.06vw, 18px);
    line-height: 1.5;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.9);
  }

  /* Desktop: Das Bild skaliert über aspect-ratio linear mit der Breite —
     Schrift, Abstände und Textbreite skalieren im selben Verhältnis
     (Figma-Werte bei 1440px ÷ 1440), damit der Text überall gleich zum
     Portrait steht und es nicht überdeckt. Ab 1440px gelten die
     Figma-Maximalwerte. Eyebrow und Fließtext behalten eine
     Lesbarkeits-Untergrenze. */
  @media (min-width: 900px) {
    .hero__grid {
      padding-bottom: min(4.514vw, 65px);
    }

    /* Breit genug, dass die zwei per <br/> erzwungenen Zeilen je eine
       Zeile bleiben statt zusätzlich umzubrechen */
    .hero__text {
      max-width: min(72.917vw, 1050px);
    }

    .hero__eyebrow {
      font-size: clamp(13px, 1.111vw, 16px);
      margin-bottom: min(0.694vw, 10px);
    }

    .hero__headline {
      font-size: min(3.889vw, 56px);
      margin-bottom: min(1.389vw, 20px);
    }

    .hero__sub {
      font-size: clamp(14px, 1.25vw, 18px);
      margin-bottom: min(2.222vw, 32px);
    }
  }
</style>
