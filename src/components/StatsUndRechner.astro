---
const KWH_PRO_AUFZUG = 15000;
const EUR_PRO_AUFZUG = 1500;
const CO2_PRO_AUFZUG = 3;

const stats = [
  { value: '15.000 kWh', label: 'pro Jahr und Aufzug' },
  { value: '1.500 €', label: 'Einsparpotenzial pro Jahr und Aufzug' },
  { value: '3 t CO₂', label: 'eingespart pro Jahr und Aufzug' },
];
---

<section class="section--navy section stats">
  <div class="container">
    <div class="stats__intro">
      <h2 class="h3">Kennzahlen zum Energieverlust im Bestand</h2>
      <p class="text-medium">
        Drei Werte zeigen das Potenzial pro Aufzug, im Bestand meist Jahr für
        Jahr ungenutzt.
      </p>
    </div>

    <ul class="stats__list">
      {stats.map((stat) => (
        <li>
          <span class="stats__value">{stat.value}</span>
          <span class="stats__label h6">{stat.label}</span>
        </li>
      ))}
    </ul>

    <div class="rechner">
      <h2 class="h3">Wie viel Energie kann Ihr Portfolio einsparen?</h2>
      <p class="text-medium">Tragen Sie hier die grobe Anzahl Ihrer Aufzüge ein.</p>

      <form class="rechner__form" data-kwh={KWH_PRO_AUFZUG} data-eur={EUR_PRO_AUFZUG} data-co2={CO2_PRO_AUFZUG}>
        <label for="anzahl-aufzuege" class="sr-only">Anzahl Aufzüge</label>
        <input
          type="number"
          id="anzahl-aufzuege"
          name="anzahl"
          min="1"
          step="1"
          placeholder="Anzahl Aufzüge"
          inputmode="numeric"
          required
        />
        <button type="submit" class="btn btn-fill-white">Ausrechnen</button>
      </form>

      <div class="rechner__result" aria-live="polite">
        <div>
          <span class="rechner__result-value" data-output="kwh">– kWh</span>
          <span class="rechner__result-label text-small">pro Jahr</span>
        </div>
        <div>
          <span class="rechner__result-value" data-output="eur">– €</span>
          <span class="rechner__result-label text-small">Einsparpotenzial pro Jahr</span>
        </div>
        <div>
          <span class="rechner__result-value" data-output="co2">– t CO₂</span>
          <span class="rechner__result-label text-small">eingespart pro Jahr</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .stats__intro {
    display: grid;
    gap: 2rem;
    margin-bottom: 60px;
  }

  .stats__intro p { color: rgba(255, 255, 255, 0.85); }

  .stats__list {
    list-style: none;
    margin: 0 0 112px;
    padding: 0;
    display: grid;
    gap: 1.5rem;
  }

  .stats__list li {
    border-left: 1px solid var(--border-dark);
    padding-left: 32px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .stats__value {
    font-size: var(--stat-number);
    font-weight: 700;
    line-height: 1.3;
  }

  .stats__label { color: rgba(255, 255, 255, 0.85); }

  .rechner {
    text-align: center;
    max-width: 908px;
    margin-inline: auto;
  }

  .rechner h2 { margin-bottom: 1.5rem; }
  .rechner > p { margin-bottom: 1.75rem; color: rgba(255, 255, 255, 0.85); }

  .rechner__form {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    max-width: 560px;
    margin-inline: auto;
  }

  .rechner__form input {
    flex: 1;
    min-width: 200px;
    padding: 8px 12px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    font-family: inherit;
    font-size: var(--text-regular);
  }

  .rechner__form input::placeholder { color: rgba(255, 255, 255, 0.6); }

  .rechner__form input:focus-visible {
    outline: 2px solid var(--color-amber);
    outline-offset: 1px;
  }

  .rechner__result {
    margin-top: 2.5rem;
    display: grid;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-dark);
  }

  .rechner__result-value {
    display: block;
    font-size: var(--heading-3);
    font-weight: 700;
  }

  .rechner__result-label { color: rgba(255, 255, 255, 0.75); }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (min-width: 700px) {
    .stats__intro { grid-template-columns: 1fr 1fr; }
    .stats__list { grid-template-columns: repeat(3, 1fr); }
    .rechner__result { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.rechner__form');
  const result = document.querySelector<HTMLElement>('.rechner__result');

  form?.addEventListener('submit', (event) => {
    event.preventDefault();

    const input = form.querySelector<HTMLInputElement>('#anzahl-aufzuege');
    const anzahl = Number(input?.value ?? 0);
    if (!anzahl || anzahl < 1) return;

    const kwh = anzahl * Number(form.dataset.kwh);
    const eur = anzahl * Number(form.dataset.eur);
    const co2 = anzahl * Number(form.dataset.co2);

    const formatter = new Intl.NumberFormat('de-DE');

    const kwhOut = result?.querySelector('[data-output="kwh"]');
    const eurOut = result?.querySelector('[data-output="eur"]');
    const co2Out = result?.querySelector('[data-output="co2"]');

    if (kwhOut) kwhOut.textContent = `${formatter.format(kwh)} kWh`;
    if (eurOut) eurOut.textContent = `${formatter.format(eur)} €`;
    if (co2Out) co2Out.textContent = `${formatter.format(co2)} t CO₂`;
  });
</script>
