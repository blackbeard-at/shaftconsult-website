---
import { Image } from 'astro:assets';
import skyline from '../assets/images/skyline.jpg';

const gruppen = [
  {
    title: 'Wer Portfolios verantwortet',
    text: 'Sie tragen Verantwortung für große Bestände und ESG-Ziele. Energieverluste im Bestand sind ein unterschätztes Risiko.',
  },
  {
    title: 'Wer Gebäude betreibt',
    text: 'Sie kennen die technischen Details vor Ort. Die unabhängige Expertise liefert eine objektive Grundlage für Entscheidungen.',
  },
  {
    title: 'Wer über Investitionen entscheidet',
    text: 'Bestehende Kosten laufen weiter, unabhängig von der Gebäudenutzung. Die Analyse zeigt, wo sich Investitionen wirklich lohnen.',
  },
];
---

<section class="section section--muted zielgruppen">
  <div class="container zielgruppen__grid">
    <Image
      src={skyline}
      alt="Skyline moderner Bürogebäude, Ansicht von unten"
      widths={[400, 700, 1000]}
      sizes="(min-width: 900px) 560px, 90vw"
      loading="lazy"
      class="zielgruppen__image"
    />
    <div class="zielgruppen__text">
      <h2 class="h2">Für wen ist SHAFTCONSULT relevant?</h2>
      <p class="zielgruppen__intro text-medium">
        Wer Verantwortung für Gebäude trägt, profitiert von unabhängiger
        Analyse und klarer Empfehlung.
      </p>
      <ul class="zielgruppen__list">
        {gruppen.map((gruppe) => (
          <li>
            <p class="h5">{gruppe.title}</p>
            <p class="text-regular">{gruppe.text}</p>
          </li>
        ))}
      </ul>
      <a href="#kontakt" class="btn btn-outline-dark">Mehr erfahren</a>
    </div>
  </div>
</section>

<style>
  .zielgruppen__grid {
    display: grid;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .zielgruppen__image {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    justify-self: center;
    align-self: center;
  }

  .zielgruppen__text { color: var(--color-navy); }
  .zielgruppen__text h2 { margin-bottom: 1.5rem; color: var(--color-navy); }
  .zielgruppen__intro { margin-bottom: 2rem; color: var(--color-navy); }

  .zielgruppen__list {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
  }

  .zielgruppen__list li {
    padding-block: 16px;
    border-bottom: 1px solid var(--border-light);
  }

  /* Figma nutzt hier rgba(255,255,255,.2) als Divider-Farbe, was auf hellem
     Grund unsichtbar wäre -- vermutlich ein Copy/Paste-Rest aus einer anderen
     Section. Ich nutze stattdessen die dunkle Divider-Farbe wie in den
     übrigen hellen Sections, damit die Trennlinie sichtbar ist. */

  .zielgruppen__list p:first-of-type { margin-bottom: 0.5rem; }

  @media (min-width: 900px) {
    .zielgruppen__grid { grid-template-columns: 1fr 1fr; }
  }
</style>
